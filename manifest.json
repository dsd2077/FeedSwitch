{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.1.4",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "permissions": ["tabs", "storage", "activeTab", "alarms", "idle", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_appActionTitle__",
    "default_icon": {
      "16": "icons/sandglass16.png",
      "48": "icons/sandglass48.png",
      "128": "icons/sandglass128.png"
    }
  },
  "icons": {
    "16": "icons/sandglass16.png",
    "48": "icons/sandglass48.png",
    "128": "icons/sandglass128.png"
  },
  "options_ui": {
    "page": "options/option.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/dsd2077",
  "commands": {
    "toggle-tracking": {
      "suggested_key": {
        "default": "Alt+F"
      },
      "description": "Toggle time tracking switch"
    }
  }
}
