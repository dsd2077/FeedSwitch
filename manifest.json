{
  "manifest_version": 3,
  "name": "Time Management",
  "version": "1.0",
  "description": "A Chrome extension to manage website usage time and set limits.",
  "permissions": ["tabs", "storage", "activeTab", "scripting", "alarms", "idle", "windows", "contextMenus"],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "网页使用时间",
    "default_icon": {
      "16": "icons/sandglass16.png",
      "48": "icons/sandglass48.png",
      "128": "icons/sandglass128.png"
    }
  },
  "icons": {
    "16": "icons/sandglass16.png",
    "48": "icons/sandglass48.png",
    "128": "icons/sandglass128.png"
  },
  "options_ui": {
    "page": "options/option.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*", "*://*.baidu.com/*", "*://*.zhihu.com/*", "*://*.blog.csdn.net/*", "*://*.juejin.cn/*", "*://*.xiaohongshu.com/*", "*://*.jianshu.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/dsd2077",
  "commands": {
    "toggle-tracking": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Alt+F"
      },
      "description": "Toggle time tracking switch"
    }
  }
}
